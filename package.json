{
  "name": "sprint-command-center",
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:server": "tsx watch server/index.ts",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true",
    "build": "cd frontend && npm run build",
    "build:mcp": "cd mcp-server && npm run build",
    "setup-mcp": "bash scripts/setup-mcp.sh",
    "start": "node --import tsx server/index.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop sprint-command-center",
    "pm2:logs": "pm2 logs sprint-command-center",
    "pm2:restart": "pm2 restart sprint-command-center",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.4",
    "express": "^4.21.0",
    "jose": "^5.9.0",
    "js-yaml": "^4.1.1",
    "nanoid": "^5.0.9",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.13",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.2"
  }
}
